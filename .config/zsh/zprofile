# macOS の /etc/zprofile は path_helper で PATH を組み直す。
# login zsh では .zshenv の後に読まれるため、ここでも Homebrew の CLI を優先し直す。
# Herdr の vendored libghostty-vt 用 Zig 0.15.2 は keg-only のため先頭へ追加する。
# nodenv の shims は .node-version を置くプロジェクトで Nodefile の版へ切り替えるため最前列に置く。
PATH="$HOME/.nodenv/shims:/opt/homebrew/opt/zig@0.15/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH
