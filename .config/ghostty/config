# ~/.config/ghostty/config

# === フォント ===
#font-family = JetBrains Mono Nerd Font
font-family = Moralerspace Neon

font-size = 14
#font-thicken = true

# かつて cmux 対策 (manaflow-ai/cmux #1793) として CJK 範囲を font-codepoint-map で
# Moralerspace Neon に固定していたが、この固定は該当範囲を regular face へ張り付けて
# CJK の太字を不可視にすることを実測した (2026-07-26、削除後に太字表示が復活)。
# cmux は不使用のため削除。cmux を再導入する場合は CJK 太字とのトレードオフに注意。

# === テーマ（システムのライト/ダークに自動追従） ===
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# === ウィンドウ ===
window-padding-x = 12
window-padding-y = 12
background-opacity = 1
background-blur-radius = 16

# === ペイン区切り ===
split-divider-color = #585b70

# === ペインナビゲーション（Option+矢印） ===
keybind = alt+left=goto_split:left
keybind = alt+down=goto_split:bottom
keybind = alt+up=goto_split:top
keybind = alt+right=goto_split:right

# === ペインナビゲーション（Cmd+矢印）→ 内側の tmux に委譲 ===
# tmux 3.6 は Super(Cmd) を Shift と同一視し区別できないため、衝突しにくい
# Ctrl+Shift+矢印 (modifier 6) の CSI を送出し、tmux 側で select-pane に割当てる。
#   \e[1;6A/B/D/C = Up/Down/Left/Right (modifier 6 = Ctrl+Shift)
keybind = cmd+up=csi:1;6A
keybind = cmd+down=csi:1;6B
keybind = cmd+left=csi:1;6D
keybind = cmd+right=csi:1;6C

# === workspace 切替 (Cmd+数字) → 内側の herdr に委譲 ===
# Ghostty の Cmd+数字を herdr へ直接渡すため、衝突しにくい Ctrl+Alt+数字
# (CSI-u modifier 7) の形で送出する。herdr 側では [keys.indexed] workspaces = "ctrl+alt"
# で受けて workspace 切替に割り当てる。
# 物理数字キーは digit_N としても解決されるため、既定の goto_tab を両方上書きする。
#   \e[49;7u = Ctrl+Alt+1 (49 = "1", modifier 7 = Ctrl+Alt)
keybind = cmd+digit_1=csi:49;7u
keybind = cmd+1=csi:49;7u
keybind = cmd+digit_2=csi:50;7u
keybind = cmd+2=csi:50;7u
keybind = cmd+digit_3=csi:51;7u
keybind = cmd+3=csi:51;7u
keybind = cmd+digit_4=csi:52;7u
keybind = cmd+4=csi:52;7u
keybind = cmd+digit_5=csi:53;7u
keybind = cmd+5=csi:53;7u
keybind = cmd+digit_6=csi:54;7u
keybind = cmd+6=csi:54;7u
keybind = cmd+digit_7=csi:55;7u
keybind = cmd+7=csi:55;7u
keybind = cmd+digit_8=csi:56;7u
keybind = cmd+8=csi:56;7u
keybind = cmd+digit_9=csi:57;7u
keybind = cmd+9=csi:57;7u

# === tab 切替 (Ctrl+数字) → 内側の herdr に委譲 ===
# 既定では Ctrl+数字は raw では意味を持たず inner に届かないため、CSI-u (kitty)
# 形式で明示送出する。herdr 側では [keys.indexed] tabs = "ctrl" で受ける。
#   \e[49;5u = Ctrl+1 (49 = "1", modifier 5 = Ctrl)
keybind = ctrl+digit_1=csi:49;5u
keybind = ctrl+1=csi:49;5u
keybind = ctrl+digit_2=csi:50;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+digit_3=csi:51;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+digit_4=csi:52;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+digit_5=csi:53;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+digit_6=csi:54;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+digit_7=csi:55;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+digit_8=csi:56;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+digit_9=csi:57;5u
keybind = ctrl+9=csi:57;5u

# === スプリット作成 ===
keybind = ctrl+s>v=new_split:right
keybind = ctrl+s>h=new_split:down
keybind = ctrl+s>e=equalize_splits
# ctrl+a の古い chord を明示解除 (reload_config は追記型で古い bind が残るため)
keybind = ctrl+a>v=unbind
keybind = ctrl+a>h=unbind
keybind = ctrl+a>e=unbind


# === ウィンドウ表示切替（どこからでも呼び出し） ===
keybind = global:cmd+backquote=toggle_visibility

# === シェル統合 ===
command = /opt/homebrew/bin/fish
shell-integration = detect
desktop-notifications = true

# === タブ切替を内側の tmux に委譲 ===
# 既定の ctrl+tab=next_tab / ctrl+shift+tab=previous_tab を上書きし、
# CSI-u (kitty) 形式のエスケープを送出して内側の tmux に window 切替させる。
# unbind だと Ghostty は ctrl+tab に何も送出せず tmux に届かないため、明示送出する。
#   \e[9;5u = Ctrl+Tab (keycode 9=Tab, modifier 5=Ctrl)
#   \e[9;6u = Ctrl+Shift+Tab (modifier 6=Ctrl+Shift)
# tmux 側 extended-keys always がこれを C-Tab / C-S-Tab として解釈する。
# Ghostty タブは super+shift+[ / ] で操作可能。
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u

# === Shift+Enter を CSI-u で送出 (Claude/Codex TUI の改行) ===
# 既定では shift+enter は素の \r としか送られず、間の herdr/tmux で shift 情報が
# 失われて Claude Code では通常 Enter (送信) として解釈される。CSI-u encoding で
# 明示送出することで内側の herdr (kitty keyboard) / tmux (extended-keys always) を
# 貫通して Claude Code / Codex CLI に届く。
#   \e[13;2u = Shift+Enter (keycode 13=Enter, modifier 2=Shift)
keybind = shift+enter=csi:13;2u

# === 設定リロード ===
keybind = cmd+shift+comma=reload_config

# === TUI (Grok 等) 中のテキストコピー ===
# mouse reporting 中は通常ドラッグがアプリに吸われる。Shift+ドラッグで端末選択し、
# 離した瞬間に system clipboard へ入れる（⌘C 不要）。
# 検証済み: Grok CLI + Ghostty でセッションログコピー可。
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-write = allow
