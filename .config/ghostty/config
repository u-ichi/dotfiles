# ~/.config/ghostty/config

# === フォント ===
#font-family = JetBrains Mono Nerd Font
font-family = Moralerspace Neon

font-size = 14
#font-thicken = true

# cmux 対策: cmux は CJK 範囲を内蔵フォント (Hiragino/PingFang) へ強制マッピング
# する font-codepoint-map 自動注入を持ち、font-family が CJK を内蔵していても
# 上書きするため日本語と英数字でフォントが食い違う (manaflow-ai/cmux #1793)。
# CJK 範囲を明示的に Moralerspace Neon へ固定して自動注入を抑止する。
# Ghostty 単体には影響しない (元々 font-family で CJK もカバーされるため)。
font-codepoint-map = U+3000-U+30FF=Moralerspace Neon
font-codepoint-map = U+3400-U+4DBF=Moralerspace Neon
font-codepoint-map = U+4E00-U+9FFF=Moralerspace Neon
font-codepoint-map = U+F900-U+FAFF=Moralerspace Neon
font-codepoint-map = U+FF00-U+FFEF=Moralerspace Neon

# === テーマ（システムのライト/ダークに自動追従） ===
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# === ウィンドウ ===
window-padding-x = 12
window-padding-y = 12
background-opacity = 1
background-blur-radius = 16

# === ペイン区切り ===
split-divider-color = #585b70

# === ペインナビゲーション（Option+矢印） ===
keybind = alt+left=goto_split:left
keybind = alt+down=goto_split:bottom
keybind = alt+up=goto_split:top
keybind = alt+right=goto_split:right

# === スプリット作成 ===
keybind = ctrl+s>v=new_split:right
keybind = ctrl+s>h=new_split:down
keybind = ctrl+s>e=equalize_splits
# ctrl+a の古い chord を明示解除 (reload_config は追記型で古い bind が残るため)
keybind = ctrl+a>v=unbind
keybind = ctrl+a>h=unbind
keybind = ctrl+a>e=unbind


# === ウィンドウ表示切替（どこからでも呼び出し） ===
keybind = global:cmd+backquote=toggle_visibility

# === シェル統合 ===
shell-integration = detect
desktop-notifications = true

# === 設定リロード ===
keybind = cmd+shift+comma=reload_config
