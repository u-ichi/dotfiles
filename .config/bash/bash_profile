# bash login shell でも Homebrew の CLI を優先する。
# Herdr の vendored libghostty-vt 用 Zig 0.15.2 は keg-only のため先頭へ追加する。
# mise の shims は .node-version / .nvmrc を置くプロジェクトで Nodefile の版へ切り替えるため最前列に置く。
PATH="$HOME/.local/share/mise/shims:/opt/homebrew/opt/zig@0.15/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export PATH
